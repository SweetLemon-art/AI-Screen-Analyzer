<?xml version="1.0" encoding="utf-8"?>
<!--
    The Gemini API key is encrypted with Android Keystore, but its ciphertext and IV
    are still stored in SharedPreferences. Exclude that preference file from cloud
    backup and device transfer so encrypted credentials cannot be restored elsewhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_screen_analyzer_sec_prefs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_screen_analyzer_sec_prefs" />
    </device-transfer>
</data-extraction-rules>
